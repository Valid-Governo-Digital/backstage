apiVersion: v1
kind: Secret
metadata:
  name: backstage-hub-secrets
  labels:
    app: backstage-hub
type: Opaque
stringData:
  POSTGRES_USER: "backstage"
  POSTGRES_PASSWORD: "change-me"
  # PAT usado pelas integrações (scaffolder cria repositórios com ele).
  # Escopos: repo, workflow, read:org.
  GITHUB_TOKEN: "ghp_change-me"
  # OAuth App do GitHub (login).
  # Callback: https://backstage.valid.ia.br/api/auth/github/handler/frame
  AUTH_GITHUB_CLIENT_ID: "change-me"
  AUTH_GITHUB_CLIENT_SECRET: "change-me"
  # OAuth 2.0 Client ID do Google (login restrito a @valid.com).
  # Redirect URI: https://backstage.valid.ia.br/api/auth/google/handler/frame
  AUTH_GOOGLE_CLIENT_ID: "change-me"
  AUTH_GOOGLE_CLIENT_SECRET: "change-me"
