apiVersion: v1
kind: Secret
metadata:
  name: backstage-hub-secrets
  labels:
    app: backstage-hub
type: Opaque
stringData:
  POSTGRES_USER: "backstage"
  POSTGRES_PASSWORD: "change-me"
  # PAT usado pelas integrações: o catálogo lê o repositório (internal)
  # Valid-Governo-Digital/templates e o scaffolder cria repositórios na org com ele.
  # Classic: repo, workflow, read:org (autorizado no SSO da org, se houver).
  # Só troque este valor DEPOIS que a imagem com login (sem guest) estiver no ar.
  GITHUB_TOKEN: "ghp_change-me"
  # OAuth App do GitHub (login restrito a membros de Valid-Governo-Digital).
  # Callback: https://backstage.valid.ia.br/api/auth/github/handler/frame
  AUTH_GITHUB_CLIENT_ID: "change-me"
  AUTH_GITHUB_CLIENT_SECRET: "change-me"
  # OAuth 2.0 Client ID do Google (login restrito a @valid.com).
  # Redirect URI: https://backstage.valid.ia.br/api/auth/google/handler/frame
  AUTH_GOOGLE_CLIENT_ID: "change-me"
  AUTH_GOOGLE_CLIENT_SECRET: "change-me"
