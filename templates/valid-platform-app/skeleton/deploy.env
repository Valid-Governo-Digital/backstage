# Valores por aplicação, gerados pelo scaffolder do Backstage.
# O workflow .github/workflows/deploy.yml é copiado sem renderização, porque contém
# expressões do próprio GitHub Actions; por isso ele lê estes valores daqui.
APP_NAME=${{ values.name }}
DOMAIN=${{ values.host }}
NAMESPACE=${{ values.name }}
APP_PORT=${{ values.port }}

# Proteção contra sequestro de hostname: por padrão o deploy falha se o registro DNS
# já existir apontando para outro IP. Só mude para true para reapontar um host
# conscientemente.
ALLOW_DNS_OVERWRITE=false
